{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f2f3ef" },
      "foreground": { "$value": "#18212b" },
      "border": { "$value": "#d9dcd6" },
      "card": { "$value": "#fffefa" },
      "cardForeground": { "$value": "#18212b" },
      "popover": { "$value": "#fffefa" },
      "popoverForeground": { "$value": "#18212b" },
      "primary": {
        "$value": "#f2b705",
        "$description": "Taxi amber for the main action and key emphasis."
      },
      "primaryForeground": { "$value": "#18212b" },
      "secondary": { "$value": "#e4e8e1" },
      "secondaryForeground": { "$value": "#18212b" },
      "muted": { "$value": "#edf0eb" },
      "mutedForeground": { "$value": "#59636b" },
      "accent": {
        "$value": "#161d27",
        "$description": "MAXIMUS night navy for strong surfaces and route context."
      },
      "accentForeground": { "$value": "#f4f6f2" },
      "destructive": { "$value": "#b42318" },
      "destructiveForeground": { "$value": "#fff5f2" },
      "input": { "$value": "#c7cdc6" },
      "ring": { "$value": "#8a5c00" },
      "chart1": { "$value": "#c38800" },
      "chart2": { "$value": "#335a73" },
      "chart3": { "$value": "#3b7c69" },
      "chart4": { "$value": "#cc6a43" },
      "chart5": { "$value": "#6874a4" },
      "sidebar": { "$value": "#161d27" },
      "sidebarForeground": { "$value": "#f4f6f2" },
      "sidebarBorder": { "$value": "#30404d" },
      "sidebarPrimary": { "$value": "#f2b705" },
      "sidebarPrimaryForeground": { "$value": "#18212b" },
      "sidebarAccent": { "$value": "#263747" },
      "sidebarAccentForeground": { "$value": "#f4f6f2" },
      "sidebarRing": { "$value": "#ffd34d" }
    },
    "dark": {
      "background": { "$value": "#111821" },
      "foreground": { "$value": "#f4f6f2" },
      "border": { "$value": "#35414c" },
      "card": { "$value": "#19232d" },
      "cardForeground": { "$value": "#f4f6f2" },
      "popover": { "$value": "#1d2934" },
      "popoverForeground": { "$value": "#f4f6f2" },
      "primary": { "$value": "#ffd34d" },
      "primaryForeground": { "$value": "#18212b" },
      "secondary": { "$value": "#26323c" },
      "secondaryForeground": { "$value": "#f4f6f2" },
      "muted": { "$value": "#202b35" },
      "mutedForeground": { "$value": "#aab4b9" },
      "accent": { "$value": "#30495b" },
      "accentForeground": { "$value": "#f5f7f4" },
      "destructive": { "$value": "#9e342d" },
      "destructiveForeground": { "$value": "#ffefeb" },
      "input": { "$value": "#3b4954" },
      "ring": { "$value": "#ffd34d" },
      "chart1": { "$value": "#ffd34d" },
      "chart2": { "$value": "#77b4d6" },
      "chart3": { "$value": "#62bf99" },
      "chart4": { "$value": "#ff9b72" },
      "chart5": { "$value": "#a6a9e4" },
      "sidebar": { "$value": "#0d141c" },
      "sidebarForeground": { "$value": "#f4f6f2" },
      "sidebarBorder": { "$value": "#27343f" },
      "sidebarPrimary": { "$value": "#ffd34d" },
      "sidebarPrimaryForeground": { "$value": "#18212b" },
      "sidebarAccent": { "$value": "#1d2c38" },
      "sidebarAccentForeground": { "$value": "#f4f6f2" },
      "sidebarRing": { "$value": "#ffd34d" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "MAXIMUS interface and body typeface."
      },
      "serif": { "$value": ["Lora", "Georgia", "serif"] },
      "mono": { "$value": ["Space Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.8rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
