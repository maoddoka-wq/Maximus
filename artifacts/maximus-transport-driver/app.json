{
  "expo": {
    "name": "MAXIMUS Chauffeur",
    "slug": "maximus-transport-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maximus-transport-driver",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f4ef"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.maximus.chauffeur",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MAXIMUS Chauffeur utilise votre position pendant votre service.",
          "locationAlwaysAndWhenInUsePermission": "MAXIMUS Chauffeur partage votre position avec votre entreprise pendant le service, même lorsque l’application est en arrière-plan.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
