FROM node:24-bookworm-slim AS frontend-build

WORKDIR /workspace

RUN corepack enable \
    && corepack prepare pnpm@10.26.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts
COPY attached_assets ./attached_assets

RUN pnpm install --frozen-lockfile
RUN PORT=10000 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/maximus run build

FROM php:8.2-apache

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    DB_CONNECTION=pgsql \
    DIGITAL_STORAGE_PATH=/var/data/digital-products \
    COMPOSER_MAX_PARALLEL_HTTP=4 \
    COMPOSER_PROCESS_TIMEOUT=900

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev unzip \
    && docker-php-ext-install pdo_pgsql \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY artifacts/api-server/laravel ./laravel
COPY render-entrypoint.sh /usr/local/bin/render-entrypoint.sh
COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/uploads.ini

RUN cd laravel \
    && attempt=1; \
    until composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader; do \
        if [ "$attempt" -ge 3 ]; then exit 1; fi; \
        echo "Composer download failed; retrying (${attempt}/3)..." >&2; \
        rm -rf vendor; \
        sleep $((attempt * 10)); \
        attempt=$((attempt + 1)); \
    done \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views \
    && chmod -R ug+rw storage bootstrap/cache \
    && chmod +x /usr/local/bin/render-entrypoint.sh \
    && printf '%s\n' \
       '<VirtualHost *:10000>' \
       '    DocumentRoot /app/laravel/public' \
       '    <Directory /app/laravel/public>' \
       '        AllowOverride All' \
       '        Require all granted' \
       '        Options -Indexes +FollowSymLinks' \
       '    </Directory>' \
       '    DirectoryIndex index.html' \
       '    ErrorLog /proc/self/fd/2' \
       '    CustomLog /proc/self/fd/1 combined' \
       '</VirtualHost>' \
       > /etc/apache2/sites-available/000-default.conf \
    && printf 'Listen 10000\n' > /etc/apache2/ports.conf

COPY --from=frontend-build /workspace/artifacts/maximus/dist/public/ ./laravel/public/

WORKDIR /app/laravel

EXPOSE 10000

CMD ["/usr/local/bin/render-entrypoint.sh"]