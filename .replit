modules = ["nodejs-24", "python-base-3.13", "php-8.2", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18546
externalPort = 5000

[[ports]]
localPort = 19399
externalPort = 3003

[[ports]]
localPort = 19624
externalPort = 3002

[[ports]]
localPort = 21136
externalPort = 4200

[[ports]]
localPort = 23301
externalPort = 3001

[[ports]]
localPort = 23334
externalPort = 3000
